# Password for /admin. Required in production (dev falls back to "admin").
ADMIN_PASSWORD=change-me

# Signs admin sessions and unlock cookies. Required in production, 16+ random characters.
# Generate one with: openssl rand -base64 32
SESSION_SECRET=

# Where the SQLite database and uploaded files live. Mount a persistent volume here.
DATA_DIR=./data

# Default site name (can also be changed in Admin → Settings).
SITE_NAME=Templink
