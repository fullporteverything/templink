# ── Supabase ─────────────────────────────────────────────────────────────
# Project URL: Supabase dashboard → Project Settings → Data API
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# Publishable (anon) key — public, browsers use it to upload. Settings → API Keys
SUPABASE_PUBLISHABLE_KEY=
# Secret (service_role) key — server only, never expose. Settings → API Keys
SUPABASE_SECRET_KEY=
# Postgres connection string. Use the *transaction pooler* (port 6543) on Vercel:
# Supabase dashboard → Connect → "Transaction pooler"
DATABASE_URL=postgresql://postgres.YOUR-PROJECT-REF:YOUR-DB-PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres
# Optional: storage bucket name (created automatically, private)
# SUPABASE_BUCKET=templink-files

# ── App ──────────────────────────────────────────────────────────────────
# Password for /admin. Required in production (dev falls back to "admin").
ADMIN_PASSWORD=change-me
# Signs admin sessions and unlock cookies. 16+ random characters: openssl rand -base64 32
SESSION_SECRET=
# Protects the daily cleanup cron. Vercel sends it automatically when set.
CRON_SECRET=
# Max upload per file in MB (default 50 = Supabase free plan limit; changeable in Settings)
# MAX_FILE_SIZE_MB=50
# Initial site name (can be changed in Admin → Settings)
SITE_NAME=Templink
